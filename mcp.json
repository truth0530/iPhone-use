{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "iphone_use": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-I", "-S", "-B", "${PLUGIN_ROOT}/server/isolated.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {"IPHONE_USE_ANALYTICS": "0", "DO_NOT_TRACK": "1", "IPHONE_USE_SAFETY_MODE": "read-only"}
    }
  }
}
